# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.*
# ...except the live state: encrypted (OpenTofu state encryption, enforced)
# and committed on purpose — history + an off-laptop copy. The pre-commit
# hook (.githooks/pre-commit) refuses a plaintext one.
!terraform.tfstate
crash.log
tfplan
*.tfplan

# Local credentials and bootstrap files with real secrets
.env
*.local.rsc

# macOS
.DS_Store

# ansible-lint cache
.ansible/

# Kubeletto: ciphertext of every shared prod secret; committing it is the operator's call (services/kubeletto/secrets.sh)
services/kubeletto/secrets.prod-snapshot.sops.json
