        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jetstream_account_storage_used{job=\"service\",instance=\"nats\"}",
          "legendFormat": "{{account}} used"
