{
  "uid": "homelab-platform-traces",
  "title": "Trace store (VictoriaTraces)",
  "description": "The lab's trace store in CT 122: health, disk against the cap, ingest, drops and errors, and a trace search by service through Grafana's Jaeger data source (ADR 0026).",
  "tags": [
    "homelab",
    "platform"
  ],
  "editable": false,
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "textbox",
        "query": "type-a-service",
        "current": {
          "text": "type-a-service",
          "value": "type-a-service"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 64,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "VictoriaTraces, CT 122 `traces` (`10.10.10.20`): OTLP/HTTP in on 10428, Jaeger query for Grafana. The store's own health first, then a trace search by service. No app sends yet (ADR 0026): the search fills when the first sender exists. Retention 30 days, capped at 16 GiB."
      }
    },
    {
      "id": 65,
      "type": "stat",
      "title": "Up (health probe)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox_http\",instance=\"traces\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "HttpProbeFailed when down. Severity from tier (standard)."
    },
    {
      "id": 66,
      "type": "stat",
      "title": "Stored, of the 16 GiB cap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vt_data_size_bytes{job=\"service\",instance=\"traces\"}) / 17179869184"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "At the cap the oldest days are dropped first."
