    {
      "id": 15,
      "type": "logs",
      "title": "Server log (postgresql@18-main)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "queryType": "instant",
          "maxLines": 500,
          "expr": "_stream:{_HOSTNAME=\"postgres\"} _SYSTEMD_UNIT:\"postgresql@18-main.service\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Errors, fatals and panics",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "queryType": "instant",
          "maxLines": 500,
