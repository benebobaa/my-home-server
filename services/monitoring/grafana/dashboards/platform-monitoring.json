{
  "uid": "homelab-platform-monitoring",
  "title": "Monitoring health",
  "description": "The monitoring stack watching itself: targets, rule evaluation, alerts, notifications, Prometheus's own storage, and the monitoring host's errors.",
  "tags": [
    "homelab",
    "platform"
  ],
  "editable": false,
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 74,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The monitoring itself: the scrape targets, the rules, Alertmanager and Prometheus's own storage. Targets of tier best-effort are left out of the counts (the `ai` VM is off by design). Alerts: `meta.yml`. The errors panel reads this host's own logs."
      }
    },
    {
      "id": 75,
      "type": "stat",
      "title": "Scrape targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{tier!=\"best-effort\"} == 0) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "TargetDown above zero, at standard and critical tiers."
    },
