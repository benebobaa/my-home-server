    {
      "type": "table",
      "title": "Alerts firing",
      "description": "Every alert firing right now except the Watchdog (always on by design). Sorted by name; the severity colours match Telegram. The runbook for each is docs/runbooks/alerts.md under the alert's name.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "alertname",
                "severity",
                "instance",
                "job"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "instance": "Host",
              "job": "Job"
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "instance": 2,
              "job": 3
            }
          }
        }
      ],
      "links": [],
