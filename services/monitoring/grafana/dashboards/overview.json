    {
      "type": "stat",
      "title": "Kubeletto error budget",
      "description": "Share of the 30-day error budget left: 100 % minus the failure share of the last 30 days (the service counts as failed when either public probe fails) as a share of the 0.5 % that the 99.5 % objective allows, which is 3 h 36 min (ADR 0036). Red under 25 %, orange under 50 %, 0 % means the objective is missed. The probes exist only since the cutover on 2026-10-14, about 25 days, so until they have 30 days the figure is of the history that exists. No alert fires on the level: KubelettoErrorBudgetBurnFast, Medium and Slow fire on how fast it is being spent. The Kubeletto board's Error budget and burn rate row has the history and the burn rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(100 * (1 - (1 - avg_over_time(min(probe_success{job=\"blackbox_public\"})[30d:1m])) / 0.005), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "mappings": [],
          "noValue": "n/a",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "links": [
