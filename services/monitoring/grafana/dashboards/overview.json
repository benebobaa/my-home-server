{
  "uid": "homelab-overview",
  "title": "Overview",
  "description": "Is the lab OK? The home board: open it first, from a Telegram alert or on a weekly review. Green means nothing needs you; every red tile links to the board that explains it.",
  "tags": [
    "homelab",
    "overview",
    "slo"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "type": "dashboards",
      "title": "Homelab boards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "name": "Annotations & Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "step": "60s",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}} {{severity}}"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the lab OK?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Critical alerts",
      "description": "Alerts firing at severity critical (Prometheus ALERTS series; Watchdog has severity none and is not counted). Red means act now, at any hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
