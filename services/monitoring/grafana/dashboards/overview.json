      "title": "WAN inbound, 7 days",
      "description": "Bytes received on the WAN port in the last 7 days. The ISP caps 1500 GB a month and throttles to 5 Mbit/s after; 350 GB a week is the pace that reaches it (rule WanQuotaPaceHigh). The chart to the right is the same number over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(ifHCInOctets{job=\"snmp_hex\", ifName=\"ether1\"}[7d])",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
