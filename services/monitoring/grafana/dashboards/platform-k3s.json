        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(kube_pod_container_status_restarts_total{job=\"service_dmz\",namespace!~\"kl-.*|kubeletto-builds\"}[30m])",
