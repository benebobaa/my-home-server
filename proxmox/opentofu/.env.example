# Copy to .env (git-ignored) and fill in the token secret below.
#
# The token is created once, on any node, with:
#
#   pveum user add terraform@pve --comment "OpenTofu guest provisioning"
#   pveum acl modify / --users terraform@pve --roles PVEAdmin
#   pveum acl modify /storage --users terraform@pve --roles PVEDatastoreAdmin
#   pveum role add TofuNetworkAccess --privs "Sys.AccessNetwork"   # URL (template) downloads
#   pveum acl modify /nodes --users terraform@pve --roles TofuNetworkAccess
#   pveum user token add terraform@pve tofu --privsep 0
#
# Usage:
#   set -a; source .env; set +a
#   tofu plan
PROXMOX_VE_API_TOKEN="terraform@pve!tofu=<uuid-secret>"
