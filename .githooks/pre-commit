#!/usr/bin/env bash
# Refuse commits that would leak secrets (see docs/runbooks/secrets.md).
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

fail=0
while IFS= read -r f; do
  case "$f" in
    .sops.yaml)
      ;; # the SOPS config itself — public keys only
    *.tfstate)
      # Only encrypted state may be committed (OpenTofu state encryption).
      if ! git show ":$f" | grep -q '"encrypted_data"'; then
        echo "BLOCKED: $f is plaintext state — encryption.tf missing or not applied?"
        fail=1
      fi
      ;;
    *.sops.env | *.sops.yaml | *.sops.yml | *.sops.json)
      if ! git show ":$f" | grep -q 'sops_mac\|"mac":\|mac:'; then
        echo "BLOCKED: $f is not SOPS-encrypted — use 'sops edit $f'"
        fail=1
      fi
      ;;
    .env | */.env | *.local.rsc)
      echo "BLOCKED: $f holds plaintext credentials — it belongs in a *.sops.env file"
      fail=1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# Secret patterns in the staged diff (tokens, keys) — the checks above only
# know file types. Pinned gitleaks via mise when available; CI scans the
# whole history either way (make secrets-scan).
if command -v mise >/dev/null 2>&1 && mise which gitleaks >/dev/null 2>&1; then
  mise exec -- gitleaks git --pre-commit --staged --redact --no-banner --log-level warn || fail=1
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --log-level warn || fail=1
else
  echo "warning: gitleaks not installed — staged diff not scanned (mise install)" >&2
fi

exit "$fail"
